<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>com.allan.OpenHere</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-name -->
    <name>GitBashOpenHere</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor email="jzl.hll@163.com" url="https://github.com/jzlhll">Allan</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Simple HTML elements (text formatting, paragraphs, and lists) can be added inside of <![CDATA[ ]]> tag.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-description -->
    <description><![CDATA[
    Built for developers who feel more at home in a real terminal than in another IDE Git dialog.<br/><br/>

    <b>One right-click. The correct repository. The terminal and command you actually want.</b><br/>
    GitBashOpenHere connects your project, the nearest Git root, and your favorite terminal without making you hunt for paths or type another long <i>cd</i> command.<br/><br/>

    <b>What it can do:</b><br/>
    • Open the current project, directory, or file location in Git Bash, macOS Terminal, or a new Warp tab.<br/>
    • Run <b>git status</b>, <b>git diff</b>, <b>git log</b>, or <b>git push</b> from the nearest Git root while keeping the selected file context.<br/>
    • Open the exact directory in Windows CMD or PowerShell when you do not want to jump to the Git root.<br/>
    • Copy a file name, copy it without the extension, or instantly reveal the current project path.<br/>
    • Work across Windows and macOS, with a custom git-bash.exe path when auto-detection is not enough.<br/>
    • Keep the menu clean by hiding actions you do not use in Settings → Other Settings.<br/>
    <br/>
    <b>Built for AI-assisted coding:</b><br/>
    Select code and the floating <i><font color='#B19CD9'>GB</font><font color='#90EE90'>O</font><font color='#B19CD9'>H</font></i> badge appears.<br/>
    One click copies the file name and exact line range, ready to paste into Cursor, Codex, or your next AI conversation.<br/>
    Less context switching, less explaining, more building. You can enable or disable the badge in Settings.<br/>
    <br/>
    <b>How to use it:</b><br/>
    Right-click a project, directory, file, editor, or editor tab, then open <b>Git Here:</b> and choose your action.<br/>
    That is it. The plugin figures out the useful path and gets out of your way.<br/>
    <br/>
    <b>Windows tip:</b> If git-bash.exe is not detected automatically, set its path in Settings.<br/>
    <br/>
    Your terminal workflow, now wired straight into the IDE.<br/>
    <img src="https://plugins.jetbrains.com/files/21517/screenshot_3ab9abf4-7134-43fa-b63f-3b3eeff383ac" alt="1">
    <img src="https://plugins.jetbrains.com/files/21517/screenshot_1dfdf244-b8d4-4111-96d9-8ef023a662ea" alt="2">
    <img src="https://plugins.jetbrains.com/files/21517/screenshot_a029e018-c693-48e3-a1e5-cc352e9405cf" alt="3">
    <img src="https://plugins.jetbrains.com/files/21517/screenshot_e6961357-c88e-4007-98e0-46092e4c9800" alt="4">
    <img src="https://plugins.jetbrains.com/files/21517/screenshot_09c45eb8-2eb7-473f-aa2c-84ca6e10abe2" alt="5">
    <br/><br/>
    <b>--- 中文说明 ---</b><br/><br/>
    写给那些真正把终端当主场的开发者：IDE 里的 Git 面板可以用，但命令行才是自己人。<br/><br/>

    <b>一次右键，自动找对仓库、打开对的终端、执行对的命令。</b><br/>
    GitBashOpenHere 直接把项目、最近的 Git 根目录和你顺手的终端接到一起。不用翻路径，不用反复 <i>cd</i>，也不用在几个窗口之间来回横跳。<br/><br/>

    <b>现在能干什么：</b><br/>
    • 在项目、目录、文件、编辑器或标签页上右键，直接打开 Git Bash、macOS Terminal 或 Warp 新标签。<br/>
    • 自动定位最近的 Git 根目录，带着当前文件上下文执行 <b>git status</b>、<b>git diff</b>、<b>git log</b> 和 <b>git push</b>。<br/>
    • Windows 下可以绕过 Git 根目录，直接在当前文件所在目录打开 CMD 或 PowerShell。<br/>
    • 一键复制文件名、复制不带扩展名的文件名，还能直接查看当前项目路径。<br/>
    • 支持 Windows/macOS；Windows 下找不到 git-bash.exe 也不慌，手动指定一下就行。<br/>
    • 菜单也不用将就，可以在 Settings → Other Settings 里隐藏你用不上的功能。<br/>
    <br/>
    <b>AI 编程这块，也给你接上了：</b><br/>
    选中代码，稍等一下就会出现 <i><font color='#B19CD9'>GB</font><font color='#90EE90'>O</font><font color='#B19CD9'>H</font></i> 浮动入口。<br/>
    点一下就能复制文件名和精确行号范围，直接丢给 Cursor、Codex 或其他 AI 对话。<br/>
    少切窗口，少解释上下文，把时间留给真正的开发。这个浮动入口也可以随时在设置里开关。<br/>
    <br/>
    <b>怎么用：</b><br/>
    在项目、目录、文件、编辑器或编辑器标签页上右键，找到 <b>Git Here:</b>，然后选你要做的事。<br/>
    就这么简单：你负责写代码，它负责把路找对。<br/>
    <br/>
    <b>Windows 提示：</b>如果没有自动识别到 git-bash.exe，去设置里指定路径即可。<br/>
    <br/>
    你的终端工作流，现在直接长在 IDE 里了。<br/>
    ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>

    <!-- Extension points defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="com.allan.githere_notify" displayType="BALLOON"/>
        <!-- 注册到 Other Settings 中的配置项 -->
        <applicationConfigurable
                instance="com.allan.openhereplugin.config.GitOpenHereConfigurable"/>
        <!-- 注册持久化组件 -->
        <applicationService
                serviceImplementation="com.allan.openhereplugin.config.GitOpenHereSettings"/>
                
        <postStartupActivity implementation="com.allan.openhereplugin.SelectionPopupInitializer"/>
    </extensions>

    <applicationListeners>
    </applicationListeners>

    <actions>
        <group id="com.allan.githere_list_project" text="Git Here:" popup="true">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <action id="allan.githere_list_project_action" class="com.allan.openhereplugin.GitBashAction" text = "git bash"/>
            <action id="allan.githere_list_project_status" class="com.allan.openhereplugin.GitBashStatusAction" text = "git status"/>
            <action id="allan.githere_list_project_diff" class="com.allan.openhereplugin.GitBashDiffAction" text = "git diff"/>
            <action id="allan.githere_list_project_log" class="com.allan.openhereplugin.GitBashLogAction" text = "git log"/>

            <action id="allan.githere_list_project_push" class="com.allan.openhereplugin.GitBashPushAction" text = "git push"/>

            <action id="allan.githere_list_project_warp_tab" class="com.allan.openhereplugin.WarpTabAction" text = "warp tab"/>

            <action id="allan.githere_list_project_window_cmd" class="com.allan.openhereplugin.WindowCmdAction" text = "Window cmd"/>

            <action id="allan.githere_list_project_copyname" class="com.allan.openhereplugin.GitBashCopyNameAction" text = "Copy Name"/>
            <action id="allan.githere_list_project_show_project_path" class="com.allan.openhereplugin.ShowProjectPathAction" text = "Show Project Path"/>
            <action id="allan.githere_list_project_copyname_no_extension" class="com.allan.openhereplugin.GitBashCopyNameNoExtensionAction" text = "Copy Name no extension"/>
        </group>

        <group id="com.allan.githere_list_editor" text="Git Here:" popup="true">
            <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="JsonPathEvaluateAction"/>
            <action id="allan.githere_list_editor_action" class="com.allan.openhereplugin.GitBashAction" text = "git bash"/>
            <action id="allan.githere_list_editor_status" class="com.allan.openhereplugin.GitBashStatusAction" text = "git status"/>
            <action id="allan.githere_list_editor_diff" class="com.allan.openhereplugin.GitBashDiffAction" text = "git diff"/>
            <action id="allan.githere_list_editor_log" class="com.allan.openhereplugin.GitBashLogAction" text = "git log"/>
            <action id="allan.githere_list_editor_warp_tab" class="com.allan.openhereplugin.WarpTabAction" text = "warp tab"/>

            <action id="allan.githere_list_editor_window_cmd" class="com.allan.openhereplugin.WindowCmdAction" text = "Window cmd"/>

            <action id="allan.githere_list_editor_copyname" class="com.allan.openhereplugin.GitBashCopyNameAction" text = "Copy Name"/>
            <action id="allan.githere_list_editor_copyname_no_extension" class="com.allan.openhereplugin.GitBashCopyNameNoExtensionAction" text = "Copy Name no extension"/>
        </group>

        <group id="com.allan.githere_list_editor_tab" text="Git Here:" popup="true">
            <add-to-group group-id="EditorTabPopupMenu" anchor="after" relative-to-action="JsonPathEvaluateAction"/>
            <action id="allan.githere_list_ed_tab_action" class="com.allan.openhereplugin.GitBashAction" text = "git bash"/>
            <action id="allan.githere_list_ed_tab_warp_tab" class="com.allan.openhereplugin.WarpTabAction" text = "warp tab"/>
            <action id="allan.githere_list_ed_tab_window_cmd" class="com.allan.openhereplugin.WindowCmdAction" text = "Window cmd"/>
            <action id="allan.githere_list_ed_tab_copyname" class="com.allan.openhereplugin.GitBashCopyNameAction" text = "Copy Name"/>
            <action id="allan.githere_list_ed_tab_copyname_no_extension" class="com.allan.openhereplugin.GitBashCopyNameNoExtensionAction" text = "Copy Name no extension"/>
        </group>
    </actions>
</idea-plugin>
